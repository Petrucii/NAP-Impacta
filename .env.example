# Ambiente
ENV=development

# Banco de dados
# Dev local: SQLite (default se vazio). Prod: Postgres (Neon ou Supabase)
DATABASE_URL=sqlite:///./nap.db
# DATABASE_URL=postgresql+psycopg://user:pass@host/db?sslmode=require

# Autenticação admin (JWT HS256)
JWT_SECRET=troque-este-segredo-por-32-bytes-random-em-prod
JWT_EXPIRES_MIN=480

# Admin seed inicial (usado só na primeira inicialização)
ADMIN_SEED_EMAIL=admin@nap.impacta.edu.br
ADMIN_SEED_PASSWORD=nap-admin-2026
ADMIN_SEED_NAME=Admin NAP

# E-mail transacional (Resend)
RESEND_API_KEY=
CONTACT_INBOX=nap@impacta.edu.br
CONTACT_FROM="NAP Impacta <nap@impacta.edu.br>"

# URLs públicas
SITE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000

# Frontend (prefixo VITE_)
VITE_API_BASE_URL=http://localhost:8000/api
VITE_SITE_URL=http://localhost:5173
